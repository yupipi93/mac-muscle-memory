# Ghostty terminal, configured so Linux terminal habits carry over.
# Symlinked to ~/.config/ghostty/config by bin/apply.sh. See docs/tools.md.

# Font: a Nerd Font, so prompt glyphs and icons render.
font-family = MesloLGS Nerd Font Mono
font-size = 13

# Linux-terminal style shortcuts, as in Terminator and GNOME Terminal (Ctrl+Shift).
# Ctrl+Tab / Ctrl+Shift+Tab to switch tabs are Ghostty defaults.
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+a=new_split:auto
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# SSH: servers do not know the xterm-ghostty terminal type, so zsh repeats what you type and
# htop fails with "Error opening terminal: xterm-ghostty". Ghostty installs its terminfo on
# the remote host the first time (ssh-terminfo, needs `tic` there) and falls back to
# TERM=xterm-256color when it cannot (ssh-env). Applies to shells started after a reload.
shell-integration-features = ssh-env,ssh-terminfo

# Quick Terminal: Cmd+` shows and hides a drop-down terminal from any app,
# like Guake or Yakuake on Linux.
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-autohide = true
